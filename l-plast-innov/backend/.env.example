# ============================================================
#  L-PLAST-INNOV — Backend — Variables d'environnement
#  Copiez ce fichier en .env et renseignez les valeurs.
#  NE JAMAIS committer le vrai .env (voir .gitignore).
# ============================================================

# --- Application ---
APP_NAME="L-PLAST-INNOV"
ENVIRONMENT="development"          # development | production
# Mode simulation : autorise les routes /api/v1/simulation/* et marque les données DEMO.
SIMULATION_MODE=true

# --- Base de données ---
# Démo (aucune installation) : SQLite local.
DATABASE_URL="sqlite:///./l_plast_innov.db"
# Production (PostgreSQL + PostGIS) : décommentez et adaptez.
# DATABASE_URL="postgresql+psycopg2://lplast:lplast@localhost:5432/l_plast_innov"

# --- Sécurité ---
# IMPORTANT : générez une clé unique en production :  python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY="dev-secret-a-remplacer-absolument-en-production"
ACCESS_TOKEN_EXPIRE_MINUTES=720
ALGORITHM="HS256"

# --- Compte administrateur initial (créé par python -m app.seed) ---
FIRST_ADMIN_EMAIL="admin@l-plast-innov.ci"
FIRST_ADMIN_PASSWORD="ChangeMoi123!"

# --- Fuseau horaire des statistiques quotidiennes ---
STATS_TIMEZONE="Africa/Abidjan"

# --- CORS (origines autorisées pour le frontend, séparées par des virgules) ---
CORS_ORIGINS="http://localhost:5173,http://localhost:3000"

# --- Seuils par défaut (modifiables par zone depuis la plateforme web) ---
DEFAULT_PREVENTIVE_THRESHOLD=10
DEFAULT_CRITICAL_THRESHOLD=20

# --- Firebase Cloud Messaging (notifications push mobile) — facultatif ---
# FCM_SERVER_KEY=""
